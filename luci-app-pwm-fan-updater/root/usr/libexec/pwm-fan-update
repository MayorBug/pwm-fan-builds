#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

set -eu
umask 077

MANIFEST_URL=https://github.com/MayorBug/pwm-fan-builds/releases/latest/download/latest.json
RELEASE_PREFIX=https://github.com/MayorBug/pwm-fan-builds/releases/download/
HTTP_CLIENT=${PWM_FAN_UPDATE_HTTP_CLIENT:-uclient-fetch}
JSONFILTER=${PWM_FAN_UPDATE_JSONFILTER:-jsonfilter}
APK=${PWM_FAN_UPDATE_APK:-apk}
WORK=
LOCK=/tmp/pwm-fan-update.lock
STATUS=${PWM_FAN_UPDATE_STATUS:-/tmp/pwm-fan-update-status.json}
ASYNC=false
LOCK_HELD=false
STATUS_PHASE=idle
STATUS_PACKAGE=
STATUS_DOWNLOADED=0
STATUS_TOTAL=0
STATUS_COMPLETED=0

cleanup()
{
	[ -z "$WORK" ] || rm -rf "$WORK"
	[ "$LOCK_HELD" = false ] || rmdir "$LOCK" 2>/dev/null || true
}

json_error()
{
	if [ "$ASYNC" = true ]; then
		status_write false false failed "$STATUS_PACKAGE" \
			"$STATUS_DOWNLOADED" "$STATUS_TOTAL" "$STATUS_COMPLETED" "$1"
		exit 1
	fi
	printf '{"success":false,"error":"%s"}\n' "$1"
	exit 1
}

status_write()
{
	local running="$1" success="$2" phase="$3" package="$4"
	local downloaded="$5" total="$6" completed="$7" error="$8" tmp
	tmp=$STATUS.$$
	printf '{"running":%s,"success":%s,"phase":"%s",' \
		"$running" "$success" "$phase" > "$tmp"
	printf '"package":"%s","downloaded":%s,"total":%s,' \
		"$package" "$downloaded" "$total" >> "$tmp"
	printf '"completed":%s,"package_count":3,"error":"%s"}\n' \
		"$completed" "$error" >> "$tmp"
	mv -f "$tmp" "$STATUS"
}

read_status()
{
	if [ -s "$STATUS" ]; then
		cat "$STATUS"
	else
		printf '%s\n' '{"running":false,"success":false,"phase":"idle","package":"","downloaded":0,"total":0,"completed":0,"package_count":3,"error":""}'
	fi
}

field()
{
	"$JSONFILTER" -i "$WORK/latest.json" -e "$1" 2>/dev/null
}

valid_version()
{
	case $1 in ''|*[!0-9A-Za-z.+_-]*) return 1 ;; *) return 0 ;; esac
}

valid_url()
{
	case $1 in "$RELEASE_PREFIX"*) return 0 ;; *) return 1 ;; esac
}

valid_sha()
{
	[ "${#1}" -eq 64 ] || return 1
	case $1 in *[!0-9a-f]*) return 1 ;; *) return 0 ;; esac
}

load_manifest()
{
	WORK=$(mktemp -d /tmp/pwm-fan-update.XXXXXX) ||
		json_error temporary_directory_failed
	"$HTTP_CLIENT" -q -T 20 -O "$WORK/latest.json" "$MANIFEST_URL" ||
		json_error manifest_download_failed

	SCHEMA=$(field '@.schema') || json_error manifest_invalid
	CHANNEL=$(field '@.channel') || json_error manifest_invalid
	VERSION=$(field '@.version') || json_error manifest_invalid
	RELEASE=$(field '@.release') || json_error manifest_invalid
	NOTES=$(field '@.release_notes_url') || json_error manifest_invalid
	SOURCE_COMMIT=$(field '@.source.commit') || json_error manifest_invalid
	CONTROLLER_SOURCE_COMMIT=$(field '@.controller_source.commit') ||
		json_error manifest_invalid
	CONTROLLER_URL=$(field '@.packages.controller.url') || json_error manifest_invalid
	CONTROLLER_SHA=$(field '@.packages.controller.sha256') || json_error manifest_invalid
	CONTROLLER_SIZE=$(field '@.packages.controller.size') || json_error manifest_invalid
	CORE_URL=$(field '@.packages.core.url') || json_error manifest_invalid
	CORE_SHA=$(field '@.packages.core.sha256') || json_error manifest_invalid
	CORE_SIZE=$(field '@.packages.core.size') || json_error manifest_invalid
	UPDATER_URL=$(field '@.packages.updater.url') || json_error manifest_invalid
	UPDATER_SHA=$(field '@.packages.updater.sha256') || json_error manifest_invalid
	UPDATER_SIZE=$(field '@.packages.updater.size') || json_error manifest_invalid

	[ "$SCHEMA" = 1 ] && [ "$CHANNEL" = stable ] ||
		json_error manifest_invalid
	valid_version "$VERSION" && valid_version "$RELEASE" ||
		json_error manifest_invalid
	valid_url "$CONTROLLER_URL" && valid_url "$CORE_URL" &&
		valid_url "$UPDATER_URL" ||
		json_error manifest_origin_rejected
	case $NOTES in
		https://github.com/MayorBug/pwm-fan-builds/releases/tag/*) ;;
		*) json_error manifest_origin_rejected ;;
	esac
	[ "${#SOURCE_COMMIT}" -eq 40 ] &&
		[ "${#CONTROLLER_SOURCE_COMMIT}" -eq 40 ] ||
		json_error manifest_invalid
	case $SOURCE_COMMIT:$CONTROLLER_SOURCE_COMMIT in
		*[!0-9a-f:]*) json_error manifest_invalid ;;
	esac
	valid_sha "$CONTROLLER_SHA" && valid_sha "$CORE_SHA" &&
		valid_sha "$UPDATER_SHA" ||
		json_error manifest_invalid
	case $CONTROLLER_SIZE:$CORE_SIZE:$UPDATER_SIZE in
		*[!0-9:]*|*::*|:*|*:) json_error manifest_invalid ;;
	esac
	[ "$CONTROLLER_SIZE" -le 2097152 ] && [ "$CORE_SIZE" -le 2097152 ] &&
		[ "$UPDATER_SIZE" -le 2097152 ] ||
		json_error package_too_large
}

installed_version()
{
	local version
	version=$("$APK" list --installed luci-app-pwm-fan 2>/dev/null |
		sed -n '1s/^luci-app-pwm-fan-\([^ ]*\).*/\1/p')
	if [ -z "$version" ]; then
		version=$("$APK" info -v luci-app-pwm-fan 2>/dev/null |
			sed -n '1s/^luci-app-pwm-fan-\([^ ]*\).*/\1/p')
	fi
	printf '%s\n' "$version"
}

check_update()
{
	local latest relation=unknown update_available=false same_version=false up_to_date=false
	load_manifest
	INSTALLED=$(installed_version)
	valid_version "${INSTALLED:-not-installed}" || INSTALLED=unknown
	latest=$VERSION-r$RELEASE
	if [ "$INSTALLED" = "$latest" ]; then
		relation='='; same_version=true; up_to_date=true
	elif [ "$INSTALLED" = unknown ] || [ "$INSTALLED" = not-installed ] ||
		[ -z "$INSTALLED" ]; then
		update_available=true
	else
		relation=$("$APK" version -t "$INSTALLED" "$latest" 2>/dev/null || printf unknown)
		case $relation in
			'<') update_available=true ;;
			'=') same_version=true; up_to_date=true ;;
			'>') up_to_date=true ;;
			*) relation=unknown; update_available=true ;;
		esac
	fi
	printf '{"success":true,"installed":"%s","version":"%s","release":"%s",' \
		"${INSTALLED:-not-installed}" "$VERSION" "$RELEASE"
	printf '"source_commit":"%s","release_notes_url":"%s",' \
		"$SOURCE_COMMIT" "$NOTES"
	printf '"controller_source_commit":"%s",' "$CONTROLLER_SOURCE_COMMIT"
	printf '"version_relation":"%s","update_available":%s,' "$relation" "$update_available"
	printf '"same_version":%s,"up_to_date":%s}\n' "$same_version" "$up_to_date"
}

fetch_package()
{
	local name="$1" url="$2" sha="$3" size="$4"
	local pid downloaded

	STATUS_PHASE=downloading
	STATUS_PACKAGE=$name
	STATUS_DOWNLOADED=0
	STATUS_TOTAL=$size
	status_write true null "$STATUS_PHASE" "$name" 0 "$size" \
		"$STATUS_COMPLETED" ''
	"$HTTP_CLIENT" -q -T 30 -O "$WORK/$name" "$url" &
	pid=$!
	while kill -0 "$pid" 2>/dev/null; do
		downloaded=$(wc -c < "$WORK/$name" 2>/dev/null || printf 0)
		STATUS_DOWNLOADED=$downloaded
		status_write true null "$STATUS_PHASE" "$name" "$downloaded" "$size" \
			"$STATUS_COMPLETED" ''
		sleep 1
	done
	if ! wait "$pid"; then
		json_error package_download_failed
	fi
	STATUS_DOWNLOADED=$(wc -c < "$WORK/$name")
	status_write true null verifying "$name" "$STATUS_DOWNLOADED" "$size" \
		"$STATUS_COMPLETED" ''
	[ "$(wc -c < "$WORK/$name")" -eq "$size" ] ||
		json_error package_size_mismatch
	printf '%s  %s\n' "$sha" "$WORK/$name" | sha256sum -c - >/dev/null ||
		json_error checksum_failed
	STATUS_COMPLETED=$((STATUS_COMPLETED + 1))
	status_write true null verified "$name" "$size" "$size" \
		"$STATUS_COMPLETED" ''
}

run_update()
{
	ASYNC=true
	LOCK_HELD=true
	trap cleanup EXIT INT TERM
	STATUS_PHASE=manifest
	status_write true null "$STATUS_PHASE" '' 0 0 0 ''
	load_manifest
	df -k /tmp | awk 'NR == 2 { exit ($4 < 4096) }' ||
		json_error insufficient_space
	fetch_package controller.apk "$CONTROLLER_URL" "$CONTROLLER_SHA" \
		"$CONTROLLER_SIZE"
	fetch_package core.apk "$CORE_URL" "$CORE_SHA" "$CORE_SIZE"
	fetch_package updater.apk "$UPDATER_URL" "$UPDATER_SHA" "$UPDATER_SIZE"
	STATUS_PHASE=installing
	STATUS_PACKAGE=
	STATUS_DOWNLOADED=0
	STATUS_TOTAL=0
	status_write true null "$STATUS_PHASE" '' 0 0 3 ''
	"$APK" add --allow-untrusted --force-reinstall "$WORK/controller.apk" "$WORK/core.apk" \
		"$WORK/updater.apk" >/dev/null ||
		json_error install_failed
	status_write false true complete '' 0 0 3 ''
}

start_update()
{
	mkdir "$LOCK" 2>/dev/null || json_error update_in_progress
	status_write true null starting '' 0 0 0 ''
	"$0" run </dev/null >/dev/null 2>&1 &
	printf '%s\n' '{"success":true,"started":true}'
}

case ${1:-} in
	check) trap cleanup EXIT INT TERM; check_update ;;
	install) start_update ;;
	status) read_status ;;
	run) run_update ;;
	*) exit 2 ;;
esac
