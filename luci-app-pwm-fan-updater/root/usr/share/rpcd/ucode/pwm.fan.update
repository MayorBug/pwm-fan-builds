#!/usr/bin/env ucode
// SPDX-License-Identifier: GPL-2.0-only

'use strict';

import { popen } from 'fs';

function helper(action) {
	let pipe = popen('/usr/libexec/pwm-fan-update ' + action, 'r');

	if (!pipe)
		return { success: false, error: 'helper_unavailable' };
	let output = pipe.read('all');
	let result = pipe.close();
	try {
		let response = json(trim(output));
		if (result != 0)
			response.success = false;
		return response;
	}
	catch (e) {
		return { success: false, error: 'invalid_response' };
	}
}

function set_channel(request) {
	let channel = request?.channel;

	if (channel != 'stable' && channel != 'development')
		return { success: false, error: 'invalid_channel' };
	return helper('channel-set ' + channel);
}

return {
	'pwm.fan.update': {
		check: {
			call: function() { return helper('check'); }
		},
		channel: {
			call: function() { return helper('channel-get'); }
		},
		set_channel: {
			args: { channel: 'stable' },
			call: set_channel
		},
		status: {
			call: function() { return helper('status'); }
		},
		install: {
			call: function() { return helper('install'); }
		}
	}
};
